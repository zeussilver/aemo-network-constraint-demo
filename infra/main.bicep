// Site Ops Console on Azure. Subscription scope so `az deployment sub what-if` can preview
// everything, including the resource group, before anything is created.
//
//   az deployment sub what-if -l newzealandnorth -f infra/main.bicep -p infra/main.bicepparam
//
// Region: the Azure for Students subscription used here only allows newzealandnorth,
// koreacentral, indonesiacentral, eastasia and japaneast ("Allowed resource deployment
// regions" policy). New Zealand North is the closest of those to the NEM.
targetScope = 'subscription'

@description('Azure region for every resource.')
param location string = 'newzealandnorth'

@description('Resource group to create or update.')
param resourceGroupName string = 'rg-siteops-nzn'

@description('Microsoft Entra object ID of the person who administers the database (az ad signed-in-user show --query id).')
param adminObjectId string

@description('User principal name for that administrator, e.g. someone@example.edu.')
param adminPrincipalName string

@description('Where ingestion alerts are emailed.')
param alertEmail string

@description('GitHub repository allowed to deploy, as owner/name.')
param githubRepository string

@description('GitHub environment whose workflow jobs may sign in as the deploy identity.')
param githubEnvironment string = 'production'

@description('Better Auth signing secret (at least 32 characters). Generated by infra/deploy.sh.')
@secure()
@minLength(32)
param betterAuthSecret string

@description('Ingestion alert on/off. On by default: the scheduled ingest runs from the default branch.')
param ingestAlertEnabled bool = true

resource rg 'Microsoft.Resources/resourceGroups@2024-03-01' = {
  name: resourceGroupName
  location: location
  tags: { app: 'site-ops-console', 'managed-by': 'bicep' }
}

module app 'resources.bicep' = {
  name: 'siteops-resources'
  scope: rg
  params: {
    location: location
    adminObjectId: adminObjectId
    adminPrincipalName: adminPrincipalName
    alertEmail: alertEmail
    githubRepository: githubRepository
    githubEnvironment: githubEnvironment
    betterAuthSecret: betterAuthSecret
    ingestAlertEnabled: ingestAlertEnabled
  }
}

output resourceGroupName string = rg.name
output webAppName string = app.outputs.webAppName
output webAppUrl string = app.outputs.webAppUrl
output postgresServerName string = app.outputs.postgresServerName
output postgresHost string = app.outputs.postgresHost
output deployIdentityName string = app.outputs.deployIdentityName
output deployIdentityClientId string = app.outputs.deployIdentityClientId
output webAppPrincipalId string = app.outputs.webAppPrincipalId
output appInsightsName string = app.outputs.appInsightsName
