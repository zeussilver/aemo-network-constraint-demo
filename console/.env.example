# Copy to .env for local development. Values here are local-only defaults.
DATABASE_URL="postgresql://ops:ops_local_only@127.0.0.1:55460/ops_console"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Staff accounts created by `npm run db:seed` (passwords: at least 12 characters)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
SEED_VIEWER_EMAIL="viewer@example.com"
SEED_VIEWER_PASSWORD=""

# Integration tests (Vitest) migrate and truncate this separate database
TEST_DATABASE_URL="postgresql://ops:ops_local_only@127.0.0.1:55460/ops_console_test"
# Playwright end-to-end tests reset and seed this separate database
E2E_DATABASE_URL="postgresql://ops:ops_local_only@127.0.0.1:55460/ops_console_e2e"
# ...and the sandbox project loads the simulator's training world into this one (the
# simulator runs on SIM_PYTHON, default ../.venv/bin/python, and needs psycopg)
SANDBOX_E2E_DATABASE_URL="postgresql://ops:ops_local_only@127.0.0.1:55460/ops_console_sim_e2e"
